# PostgreSQL connection string (required)
# On Railway: injected automatically when you add a Postgres service to the project
# Locally: create a local Postgres DB and set this manually
DATABASE_URL=postgres://user:password@host:5432/database

# Timezone for correct date extraction (recommended for non-UTC machines/servers)
# Set this to your local timezone on Railway → Variables
TZ=America/Sao_Paulo

# Autenticação por senha (Sessão 2)
# APP_PASSWORD: a senha que o dono digita para ver os dados
# AUTH_SECRET: string aleatória para assinar o cookie de sessão
#   Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_PASSWORD=sua-senha-aqui
AUTH_SECRET=gere-uma-string-longa-e-aleatoria-aqui
